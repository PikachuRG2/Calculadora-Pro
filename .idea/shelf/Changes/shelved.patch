<+><!DOCTYPE html>\r\n<html lang=\"pt-BR\">\r\n<head>\r\n<title>Posto Paraíso - Calculadora</title>\r\n\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<link rel=\"manifest\" href=\"manifest.json\">\r\n<meta name=\"theme-color\" content=\"#003366\">\r\n\r\n<style>\r\n    :root {\r\n        --verde: #006b36;\r\n        --amarelo: #ffd100;\r\n        --cinza: #f1f1f1;\r\n        --texto: #333333;\r\n        --logo: #eead2d;\r\n        --azul-escuro: #003366;\r\n    }\r\n\r\n    body {\r\n        font-family: Arial, sans-serif;\r\n        background: var(--logo);\r\n        padding: 0;\r\n        margin: 0;\r\n    }\r\n\r\n    header {\r\n        background: var(--azul-escuro);\r\n        color: white;\r\n        text-align: center;\r\n        padding: 18px;\r\n        font-size: 20px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    h3 { \r\n        color: var(--verde); \r\n        margin-top: 15px; \r\n        font-size: 16px;\r\n    }\r\n\r\n    button {\r\n        width: 100%;\r\n        padding: 10px;\r\n        margin-top: 8px;\r\n        font-size: 16px;\r\n        cursor: pointer;\r\n        border: none;\r\n        border-radius: 8px;\r\n        font-weight: bold;\r\n        transition: 0.2s;\r\n    }\r\n\r\n    .selecionado {\r\n        border: 3px solid #000;\r\n        filter: brightness(1.15);\r\n    }\r\n\r\n    .produto { background: var(--amarelo); color: var(--texto); }\r\n    .pix { background: var(--verde); color: white; }\r\n    .debito { background: #1f7bb6; color: white; }\r\n\r\n    #resultado {\r\n        margin-top: 15px;\r\n        padding: 14px;\r\n        background: var(--cinza);\r\n        border-radius: 8px;\r\n        text-align: center;\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    input {\r\n        width: 100%;\r\n        padding: 12px;\r\n        font-size: 16px;\r\n        margin-top: 8px;\r\n        border-radius: 8px;\r\n        border: 1px solid #111;\r\n    }\r\n\r\n    .botao-calculadora {\r\n        position: fixed;\r\n        bottom: 12px !important;\r\n        left: 12px !important;\r\n        right: 20px !important;\r\n        background: var(--verde);\r\n        color: white;\r\n        padding: 6px 10px !important;\r\n        font-size: 12px !important;\r\n        border-radius: 999px !important;\r\n        border: none;\r\n        cursor: pointer;\r\n        box-shadow: 0 4px 8px rgba(0,0,0,0.3);\r\n        z-index: 1000;\r\n    }\r\n</style>\r\n</head>\r\n\r\n<body>\r\n\r\n<header>⚽ POSTO PARAÍSO ⚽</header>\r\n\r\n<div id=\"calculadora\" class=\"container\">\r\n\r\n    <h3>Produto</h3>\r\n    <button id=\"gasolina\" class=\"produto\" onclick=\"selecionarProduto('gasolina')\">Gasolina Comum</button>\r\n    <button id=\"aditivada\" class=\"produto\" onclick=\"selecionarProduto('aditivada')\">Gasolina Aditivada</button>\r\n    <button id=\"diesel\" class=\"produto\" onclick=\"selecionarProduto('diesel')\">Diesel Comum/S10</button>\r\n    <button id=\"alcool\" class=\"produto\" onclick=\"selecionarProduto('alcool')\">Álcool</button>\r\n\r\n    <h3>Forma de Pagamento</h3>\r\n    <button id=\"pix\" class=\"pix\" onclick=\"selecionarPagamento('pix')\">Pix</button>\r\n    <button id=\"debito\" class=\"debito\" onclick=\"selecionarPagamento('debito')\">Débito</button>\r\n\r\n    <h3>Calcular por Litros</h3>\r\n    <input type=\"number\" id=\"litros\" placeholder=\"Digite os litros\" oninput=\"calcular()\">\r\n\r\n    <h3>Calcular por Dinheiro</h3>\r\n    <input type=\"number\" id=\"dinheiro\" placeholder=\"Digite o valor em R$\" oninput=\"calcular()\">\r\n\r\n    <div id=\"resultado\">Total: R$ 0,00</div>\r\n</div>\r\n\r\n<button class=\"botao-calculadora\" onclick=\"window.location.href='https://pikachurg2.github.io/Calculadora-Pro-PP/'\">\r\n    Calculadora\r\n</button>\r\n\r\n<script>\r\n    let produto = null;\r\n    let pagamento = null;\r\n\r\n    const precos = {\r\n        gasolina: { pix: 6.39, debito: 6.59 },\r\n        aditivada: { pix: 6.49, debito: 6.69 },\r\n        diesel:   { pix: 5.75, debito: 5.99 },\r\n        alcool:   { pix: 4.90, debito: 4.90 }\r\n    };\r\n\r\n    function selecionarProduto(tipo) {\r\n        produto = tipo;\r\n\r\n        document.querySelectorAll(\".produto\").forEach(btn => btn.classList.remove(\"selecionado\"));\r\n        document.getElementById(tipo).classList.add(\"selecionado\");\r\n\r\n        calcular();\r\n    }\r\n\r\n    function selecionarPagamento(tipo) {\r\n        pagamento = tipo;\r\n\r\n        document.querySelectorAll(\".pix, .debito\").forEach(btn => btn.classList.remove(\"selecionado\"));\r\n        document.getElementById(tipo).classList.add(\"selecionado\");\r\n\r\n        calcular();\r\n    }\r\n\r\n    function calcular() {\r\n        const litros = parseFloat(document.getElementById(\"litros\").value);\r\n        const dinheiro = parseFloat(document.getElementById(\"dinheiro\").value);\r\n\r\n        if (!produto || !pagamento) {\r\n            document.getElementById(\"resultado\").innerHTML = \"Selecione produto e pagamento\";\r\n            return;\r\n        }\r\n\r\n        const preco = precos[produto][pagamento];\r\n        const nomeProduto = \r\n            produto === \"gasolina\" ? \"Gasolina Comum\" :\r\n            produto === \"aditivada\" ? \"Gasolina Aditivada\" :\r\n            produto === \"diesel\" ? \"Diesel S10\" : \r\n            \"Álcool\";\r\n\r\n        const nomePagamento = pagamento === \"pix\" ? \"Pix\" : \"Débito\";\r\n\r\n        if (!isNaN(litros) && litros > 0) {\r\n            const total = litros * preco;\r\n            document.getElementById(\"resultado\").innerHTML =\r\n                `${nomeProduto} (${nomePagamento})<br><br>\r\n                Total: <strong>R$ ${total.toFixed(2)}</strong>`;\r\n            return;\r\n        }\r\n\r\n        if (!isNaN(dinheiro) && dinheiro > 0) {\r\n            const litrosResult = dinheiro / preco;\r\n            document.getElementById(\"resultado\").innerHTML =\r\n                `${nomeProduto} (${nomePagamento})<br><br>\r\n                Litros: <strong>${litrosResult.toFixed(2)} L</strong>`;\r\n            return;\r\n        }\r\n\r\n        document.getElementById(\"resultado\").innerHTML = \"Total: R$ 0,00\";\r\n    }\r\n\r\n    // ATIVANDO PWA\r\n    if (\"serviceWorker\" in navigator) {\r\n        navigator.serviceWorker.register(\"sw.js\");\r\n    }\r\n</script>\r\n\r\n</body>\r\n</html>\r\n\r\n\r\n\r\n
